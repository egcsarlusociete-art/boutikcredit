rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // CNI — accessible uniquement par l'utilisateur concerné
    match /cni/{uid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Articles — lecture publique, écriture authentifiée
    match /articles/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Default
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
